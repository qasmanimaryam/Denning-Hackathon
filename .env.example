# =====================================================
# Wazifa Saathi — Environment Variables Configuration
# Copy this file to .env and fill in at least one API key:
#   cp .env.example .env
# =====================================================

# Primary LLM provider: "gemini" or "anthropic"
LLM_PROVIDER=gemini

# Google Gemini configuration (official google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Anthropic Claude configuration (official anthropic SDK)
# Used when LLM_PROVIDER=anthropic, or as automatic fallback if Gemini fails
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
